# VS Code Jupyter는 워크스페이스 루트의 이 파일을 커널 환경변수로 불러옵니다.
# 저장소 루트를 VS Code 폴더로 열어야 적용됩니다.
#
# 이 파일은 커밋 대상이며 실행 설정만 저장합니다. 시크릿은 넣지 마세요.
# HF 토큰은 `hf auth login`, 역할 ARN은 셸의 SAGEMAKER_ROLE_ARN을 사용합니다.
# 개인 설정은 gitignore에 포함된 `.env.local`에 저장합니다.

# HF 모델 캐시와 `hf auth login` 토큰 경로입니다. 환경에 맞게 수정하세요.
HF_HOME=/home/ubuntu/hf-cache

# 학습과 서빙 인스턴스입니다. L4 24GB를 사용하는 g6를 기본으로 둡니다.
TRAIN_INSTANCE_TYPE=ml.g6.2xlarge
INFER_INSTANCE_TYPE=ml.g6.2xlarge

# 학습 DLC의 완전한 URI입니다. 이 값은 자동 이미지 해석보다 우선합니다.
# URI의 리전은 AWS_REGION과 같아야 합니다. 이 줄을 주석 처리하면 common/dlc.py가 URI를 조립합니다.
DLC_IMAGE_URI=763104351884.dkr.ecr.us-west-2.amazonaws.com/pytorch-training:2.10.0-gpu-py313-cu130-ubuntu22.04-sagemaker-v1.7
# 태그 확인:
# aws ecr describe-images --registry-id 763104351884 --repository-name pytorch-training \
#   --image-ids imageTag=<태그> --region <리전>

# 서빙 엔진입니다. 세 엔진 모두 OpenAI 호환 messages 스키마를 사용합니다.
SERVING_ENGINE=vllm

# 서빙 DLC의 완전한 URI입니다. 모든 URI의 리전을 AWS_REGION과 맞추세요.
VLLM_IMAGE_URI=763104351884.dkr.ecr.us-west-2.amazonaws.com/vllm:0.26.0-gpu-py312-cu130-ubuntu22.04-sagemaker-v1.1
SGLANG_IMAGE_URI=763104351884.dkr.ecr.us-west-2.amazonaws.com/sglang:0.5.15-gpu-py312-cu130-ubuntu24.04-sagemaker
LMI_IMAGE_URI=763104351884.dkr.ecr.us-west-2.amazonaws.com/djl-inference:0.36.0-lmi27.0.0-cu130-v1.1
HF_INFER_IMAGE_URI=763104351884.dkr.ecr.us-west-2.amazonaws.com/huggingface-pytorch-inference:2.6.0-transformers5.5.3-gpu-py312-cu124-ubuntu22.04

# 합성 데이터 규모입니다. 요약 코스는 입력이 길어 기본값을 100으로 둡니다.
NUM_SYNTHETIC=100
# SYNTH_MAX_WORKERS=10   # 429 오류가 발생하면 낮추세요.

# 실험 추적은 기본적으로 끕니다. 반복 실험을 기록할 때만 1로 바꾸세요.
# App을 찾지 못하면 로컬 SQLite를 사용합니다. App은 mlflow_setup.ipynb에서 만듭니다.
# App 이름은 MLFLOW_APP_NAME, 직접 지정할 대상은 MLFLOW_TRACKING_URI에 설정합니다.
USE_MLFLOW=0

# 자주 바꾸는 선택 설정입니다. 기본값은 common/config.py에 있습니다.
AWS_REGION=us-west-2
# BEDROCK_CLAUDE_MODEL_ID=global.anthropic.claude-sonnet-5
# DRY_RUN=1

# HF_TOKEN은 저장하지 마세요. gated 모델은 `hf auth login`으로 인증합니다.
