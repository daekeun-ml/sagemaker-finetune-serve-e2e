# =============================================================================
# 이 리포는 '튜토리얼 자산'입니다 — 노트북·스크립트·문서만 커밋합니다.
# 실행하면 생기는 것(모델 가중치, 학습 데이터, 캐시)은 전부 제외합니다.
# =============================================================================

# --- 시크릿 (절대 커밋 금지) ---
# 🔴 .env 는 커밋합니다 — 이 kit의 .env 는 '설정'만 담습니다(인스턴스 타입, DLC 이미지 URI,
#    리전, 합성 건수). 시크릿은 넣지 않는 규칙이고, 토큰은 `hf auth login`(파일 저장)으로,
#    role ARN 은 셸 export 로 둡니다. 커밋해 두면 실습자가 그대로 열어 볼 수 있습니다.
#    ⚠️ 개인 값(토큰·ARN·계정 ID)을 .env 에 넣었다면 커밋 전에 반드시 지우세요.
.env.local
.env.*.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- uv ---
# uv.lock 은 재현성을 위해 커밋 권장 → 무시하지 않음

# --- 모델 가중치·아티팩트 (용량 큼. 실측 이 리포에서 53GB가 여기 해당) ---
out/
out_dryrun/
local_model/
_hf_repack/
*.safetensors
*.bin
*.pt
*.pth
*.tar.gz
*.onnx

# --- 노트북이 생성하는 데이터 (시드/합성 — 01 노트북을 돌리면 다시 만들어짐) ---
tracks/*/data/
# 단, 멀티모달 배포 검증용 샘플 이미지는 커밋한다(248KB, 없으면 노트북이 40초 대기).
!tracks/05_multimodal_extraction/samples/

# --- pipelines/ 의 스테이지 간 상태 (노트북 %store 대체) ---
# 🔴 model_data / endpoint_name 같은 '내 계정의 실행 결과'가 들어갑니다(버킷 이름에 계정 ID 포함)
#    → 커밋하지 않습니다. 지워도 그 스테이지만 다시 돌리면 됩니다(캐시입니다).
#    config.yaml 은 설정만 담고 시크릿이 없으므로 커밋합니다.
.pipeline_state/

# --- 벤치마크·임시 산출물 ---
bench/
req.json
/tmp/
hf-cache/

# --- AgentCore가 생성하는 프로젝트 (create_agent.sh 산출물) ---
agentcore/gemma*/
agentcore/.agentcore*/

# --- MkDocs 빌드 산출물 (CI가 생성) ---
site/

# --- 패키지 빌드 부산물 (uv/pip 가 남기는 wheel) ---
*.whl
*.tar.bz2

# --- 로그·OS ---
*.log
.DS_Store
Thumbs.db
