# =============================================================================
# 이 저장소는 노트북, 스크립트, 문서만 커밋합니다.
# 실행하면 생기는 것(모델 가중치, 학습 데이터, 캐시)은 전부 제외합니다.
# =============================================================================

# 시크릿
# .env에는 공개 가능한 기본 설정만 둡니다.
# 개인 토큰, ARN, 계정 ID는 .env.local이나 셸 환경변수로 관리하세요.
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
# uv.lock은 재현성을 위해 커밋합니다.

# 모델 가중치와 아티팩트
out/
out_dryrun/
local_model/
_hf_repack/
*.safetensors
*.bin
*.pt
*.pth
*.tar.gz
*.onnx

# 노트북이 생성하는 데이터
tracks/*/data/
# 단, 멀티모달 배포 검증용 샘플 이미지는 커밋한다(248KB, 없으면 노트북이 40초 대기).
!tracks/05_multimodal_extraction/samples/

# 파이프라인 스테이지 간 상태
# 계정별 모델 경로와 엔드포인트 이름이 포함되므로 커밋하지 않습니다.
.pipeline_state/

# 벤치마크와 임시 산출물
bench/
req.json
/tmp/
hf-cache/

# AgentCore가 생성하는 프로젝트
agentcore/gemma*/
agentcore/.agentcore*/

# MkDocs 빌드 산출물
site/

# 패키지 빌드 산출물
*.whl
*.tar.bz2

# 로그와 운영체제 파일
*.log
.DS_Store
Thumbs.db

# 벤치마크 결과
# 도구가 cwd 에 sagemaker-<rate>-concurrency<N>-<endpoint>-<타임스탬프>.json 을 쓴다.
# endpoint 이름이 파일명에 들어가므로 커밋하지 않는다.
sagemaker-*concurrency*.json
# --course 없이 돌렸을 때의 기본 출력 위치(코스를 주면 tracks/*/data/ 로 가고 그쪽은 이미 무시된다).
bench_results/

# 로컬 MLflow DB와 artifact. run에 endpoint 이름과 S3 경로가 포함될 수 있습니다.
.mlflow/
mlruns/
